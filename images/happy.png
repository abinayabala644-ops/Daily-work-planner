<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 293" width="440" height="293">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ecfdf5"/>
      <stop offset="100%" stop-color="#d1fae5"/>
    </linearGradient>
    <linearGradient id="faceGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="100%" stop-color="#eab308"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#047857" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="440" height="293" rx="16" fill="url(#bgGrad)"/>

  <!-- Centered Emoji Avatar -->
  <g transform="translate(220, 146)">
    <!-- Face Background with shadow -->
    <circle r="72" fill="url(#faceGrad)" filter="url(#shadow)" stroke="#ca8a04" stroke-width="2.5"/>

    <!-- Happy Eyes (curved arc) -->
    <path d="M-38 -12 Q-26 -28 -14 -12" fill="none" stroke="#713f12" stroke-width="5" stroke-linecap="round"/>
    <path d="M14 -12 Q26 -28 38 -12" fill="none" stroke="#713f12" stroke-width="5" stroke-linecap="round"/>

    <!-- Rosy Cheeks -->
    <circle cx="-42" cy="14" r="9" fill="#f87171" opacity="0.45"/>
    <circle cx="42" cy="14" r="9" fill="#f87171" opacity="0.45"/>

    <!-- Big Happy Smile with white teeth & tongue -->
    <path d="M-36 10 Q0 60 36 10 Z" fill="#713f12"/>
    <path d="M-28 12 Q0 24 28 12 Q20 20 0 20 Q-20 20 -28 12 Z" fill="#ffffff"/>
    <path d="M-18 25 Q0 26 18 25 Q12 48 0 48 Q-12 48 -18 25 Z" fill="#f43f5e"/>

    <!-- Thumbs Up Left -->
    <g transform="translate(-76, 26) rotate(-15)">
      <circle cx="0" cy="0" r="18" fill="#fde047" stroke="#ca8a04" stroke-width="2"/>
      <path d="M-4 -4 L0 -14 Q3 -18 7 -14 L6 -4" fill="#fde047" stroke="#ca8a04" stroke-width="2" stroke-linecap="round"/>
      <text x="-6" y="5" font-family="system-ui, sans-serif" font-size="14" font-weight="800" fill="#713f12">👍</text>
    </g>

    <!-- Thumbs Up Right -->
    <g transform="translate(76, 26) rotate(15)">
      <circle cx="0" cy="0" r="18" fill="#fde047" stroke="#ca8a04" stroke-width="2"/>
      <text x="-8" y="5" font-family="system-ui, sans-serif" font-size="14" font-weight="800" fill="#713f12">👍</text>
    </g>

    <!-- Sparkles -->
    <path d="M-58 -55 L-54 -45 L-44 -41 L-54 -37 L-58 -27 L-62 -37 L-72 -41 L-62 -45 Z" fill="#059669"/>
    <path d="M58 -55 L62 -45 L72 -41 L62 -37 L58 -27 L54 -37 L44 -41 L54 -45 Z" fill="#059669"/>
  </g>
</svg>
